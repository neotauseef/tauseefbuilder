{% extends "layout.njk" %}
{% block content %}
<section class="page-hero page-hero--centered">
  <div class="page-hero__eyebrow">§ RECEIVED · REF {{ ref }}</div>
  <h1 class="page-hero__h">Received. We'll be in touch within one business day.</h1>
  <p class="page-hero__lede">If the matter is urgent, call {{ site.principal.mobile }} ({{ site.principal.name }}, {{ site.principal.role }}).</p>
  <p><a class="btn btn--ghost" href="/">← Back to home</a></p>
</section>
{% endblock %}
