{% extends "layout.njk" %}
{% block content %}

<section class="page-hero">
  <div class="page-hero__eyebrow">{{ services.intro.eyebrow }}</div>
  <h1 class="page-hero__h">{{ services.intro.headline }}</h1>
  <p class="page-hero__lede">{{ services.intro.lede }}</p>
</section>

<section class="services-detail">
  {% for s in services.items %}
    <article class="svc" id="s{{ loop.index }}">
      <div class="svc__head">
        <div class="svc__mark">{{ s.mark }}</div>
        <h2 class="svc__name">{{ s.name }}</h2>
        <div class="svc__trigger">{{ s.trigger }}</div>
      </div>
      <dl class="svc__spec">
        <div><dt>Typical fee</dt><dd>{{ s.fee }}</dd></div>
        <div><dt>Typical duration</dt><dd>{{ s.duration }}</dd></div>
      </dl>
      <div class="svc__body">
        <div class="svc__block">
          <h3>What it is</h3>
          <p>{{ s.what }}</p>
        </div>
        <div class="svc__block">
          <h3>When you'd call us</h3>
          <p>{{ s.when }}</p>
        </div>
        <div class="svc__block">
          <h3>What you get</h3>
          <p>{{ s.deliverable }}</p>
        </div>
      </div>
    </article>
  {% endfor %}
</section>

<section class="section section--cta-final">
  <h2 class="cta-final__h">Have a live matter that fits one of these?</h2>
  <a class="btn btn--primary btn--large" href="/contact">Start an enquiry <span aria-hidden="true">→</span></a>
</section>

{% endblock %}
