{% extends "layout.njk" %}
{% block content %}

<section class="page-hero">
  <div class="page-hero__eyebrow">{{ contact.intro.eyebrow }}</div>
  <h1 class="page-hero__h">{{ contact.intro.headline }}</h1>
  <p class="page-hero__lede">{{ contact.intro.lede }}</p>
</section>

<section class="enquire">
  <form class="form" method="post" action="/enquiry" novalidate>
    {% if errors and errors.length %}
      <div class="form__errors" role="alert">
        <div class="form__errors-h">Please check the following:</div>
        <ul>{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>
      </div>
    {% endif %}

    <div class="form__grid">
      <label class="field field--select">
        <span class="field__label">Project type</span>
        <select name="project_type" required>
          <option value="">Select…</option>
          {% for t in contact.form.project_types %}
            <option value="{{ t }}" {% if values and values.project_type == t %}selected{% endif %}>{{ t }}</option>
          {% endfor %}
        </select>
      </label>

      <label class="field field--select">
        <span class="field__label">Stage</span>
        <select name="stage" required>
          <option value="">Select…</option>
          {% for s in contact.form.stages %}
            <option value="{{ s }}" {% if values and values.stage == s %}selected{% endif %}>{{ s }}</option>
          {% endfor %}
        </select>
      </label>

      <label class="field field--full">
        <span class="field__label">What's going on?</span>
        <textarea name="message" rows="5" maxlength="4000" required placeholder="Contract type, project value, what's moved, deadline if any.">{% if values %}{{ values.message }}{% endif %}</textarea>
      </label>

      <label class="field">
        <span class="field__label">Your name</span>
        <input type="text" name="name" autocomplete="name" required maxlength="120" value="{% if values %}{{ values.name }}{% endif %}">
      </label>

      <label class="field">
        <span class="field__label">Company (optional)</span>
        <input type="text" name="company" autocomplete="organization" maxlength="120" value="{% if values %}{{ values.company }}{% endif %}">
      </label>

      <label class="field">
        <span class="field__label">Email</span>
        <input type="email" name="email" autocomplete="email" required maxlength="200" value="{% if values %}{{ values.email }}{% endif %}">
      </label>

      <label class="field">
        <span class="field__label">Phone (optional)</span>
        <input type="tel" name="phone" autocomplete="tel" maxlength="30" value="{% if values %}{{ values.phone }}{% endif %}">
      </label>

      {# honeypot #}
      <div class="hp" aria-hidden="true">
        <label>Do not fill this field
          <input type="text" name="website" tabindex="-1" autocomplete="off">
        </label>
      </div>
    </div>

    <div class="form__foot">
      <p class="form__note">By sending you agree we may contact you about this enquiry. We do not add you to a list.</p>
      <button class="btn btn--primary btn--large" type="submit">Send enquiry <span aria-hidden="true">→</span></button>
    </div>
  </form>

  <aside class="direct">
    <div class="direct__mark">§ DIRECT</div>
    <div class="direct__block">
      <div class="direct__h">{{ site.principal.name }}</div>
      <div>{{ site.principal.role }}</div>
    </div>
    <div class="direct__block">
      <div class="direct__h">Mobile</div>
      <a href="{{ site.principal.mobile_href }}">{{ site.principal.mobile }}</a>
    </div>
    <div class="direct__block">
      <div class="direct__h">Office</div>
      <a href="{{ site.principal.office_href }}">{{ site.principal.office }}</a>
    </div>
    <div class="direct__block">
      <div class="direct__h">Firm</div>
      <div>{{ site.firm.long_name }}</div>
      <div>{{ site.firm.descriptor }}</div>
      <div>{{ site.firm.tagline }}</div>
      <div>ABN {{ site.firm.abn }}</div>
      <div>License No. {{ site.firm.license }}</div>
    </div>
  </aside>
</section>

{% endblock %}
