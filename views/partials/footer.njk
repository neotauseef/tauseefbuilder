<footer class="footer" role="contentinfo">
  <div class="footer__grid">
    <div class="footer__brand">
      <div class="footer__logo">ACC &amp; Associates</div>
      <div class="footer__tagline">Strategy · Planning · Delivery</div>
      <div class="footer__meta">ABN {{ site.firm.abn }} &middot; Founded {{ site.firm.founded }}</div>
    </div>
    <div class="footer__col">
      <div class="footer__col-h">Offices</div>
      {% for o in site.offices %}
        <div class="footer__office">
          <div class="footer__office-city">{{ o.city }}</div>
          <div>{{ o.line1 }}</div>
          <div>{{ o.line2 }}</div>
          <a href="tel:{{ o.phone | replace(' ', '') }}">{{ o.phone }}</a>
        </div>
      {% endfor %}
    </div>
    <div class="footer__col">
      <div class="footer__col-h">Direct</div>
      <a class="footer__email" href="mailto:{{ site.email }}">{{ site.email }}</a>
      <div class="footer__col-h footer__col-h--mt">Site</div>
      {% for item in site.nav %}
        <a class="footer__navlink" href="{{ item.href }}">{{ item.label }}</a>
      {% endfor %}
    </div>
  </div>
  <div class="footer__base">
    <div>&copy; {{ year }} ACC &amp; Associates Construction Consulting. All rights reserved.</div>
    <div class="footer__palette" aria-label="Palette swatches">
      <span class="sw" style="background:#1B4332" title="Field #1B4332"></span>
      <span class="sw" style="background:#B4873A" title="Brass #B4873A"></span>
      <span class="sw" style="background:#5C8060" title="Moss #5C8060"></span>
      <span class="sw" style="background:#8A9A87" title="Sage #8A9A87"></span>
      <span class="sw" style="background:#F5F2E8" title="Chalk #F5F2E8"></span>
      <span class="footer__palette-label">Gold &amp; Green</span>
    </div>
  </div>
</footer>
