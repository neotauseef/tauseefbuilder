<footer class="footer" role="contentinfo">
  <div class="footer__grid">
    <div class="footer__brand">
      <img class="footer__mark" src="/acc-logo-mark.svg" alt="ACC" width="72" height="48">
      <div class="footer__logo">{{ site.firm.name }}</div>
      <div class="footer__tagline">{{ site.firm.descriptor }} · {{ site.firm.tagline }}</div>
      <div class="footer__motto">{{ site.firm.motto }}</div>
      <div class="footer__meta">ABN {{ site.firm.abn }} &middot; License No. {{ site.firm.license }} &middot; Established {{ site.firm.founded }}</div>
    </div>
    <div class="footer__col">
      <div class="footer__col-h">Direct</div>
      <div>{{ site.principal.name }} · {{ site.principal.role }}</div>
      <div>Office <a href="{{ site.principal.office_href }}">{{ site.principal.office }}</a></div>
      <div>Email  <a href="{{ site.principal.email_href }}">{{ site.principal.email }}</a></div>
      <div>Web    <a href="{{ site.principal.web_href }}">{{ site.principal.web }}</a></div>
      <div class="footer__addr">{{ site.office.address }}</div>
    </div>
    <div class="footer__col">
      <div class="footer__col-h">Site</div>
      {% for item in site.nav %}
        <a class="footer__navlink" href="{{ item.href }}">{{ item.label }}</a>
      {% endfor %}
      <a class="footer__navlink" href="/portal">Client Portal</a>
    </div>
  </div>
  <div class="footer__base">
    <div>&copy; {{ year }} {{ site.firm.long_name }}. {{ site.firm.tagline }}.</div>
    <div class="footer__region">{{ site.office.region }}</div>
  </div>
</footer>
