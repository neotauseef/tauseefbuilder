<footer class="footer" role="contentinfo">
  <div class="footer__grid">
    <div class="footer__brand">
      <div class="footer__logo">ACC Associates</div>
      <div class="footer__tagline">{{ site.firm.descriptor }} · {{ site.firm.tagline }}</div>
      <div class="footer__meta">ABN {{ site.firm.abn }} &middot; License No. {{ site.firm.license }} &middot; Established {{ site.firm.founded }}</div>
    </div>
    <div class="footer__col">
      <div class="footer__col-h">Direct</div>
      <div class="footer__office">
        <div class="footer__office-city">{{ site.principal.name }}</div>
        <div>{{ site.principal.role }}</div>
        <div>Mobile <a href="{{ site.principal.mobile_href }}">{{ site.principal.mobile }}</a></div>
        <div>Office <a href="{{ site.principal.office_href }}">{{ site.principal.office }}</a></div>
        <div>Email  <a href="{{ site.principal.email_href }}">{{ site.principal.email }}</a></div>
      </div>
    </div>
    <div class="footer__col">
      <div class="footer__col-h">Site</div>
      {% for item in site.nav %}
        <a class="footer__navlink" href="{{ item.href }}">{{ item.label }}</a>
      {% endfor %}
    </div>
  </div>
  <div class="footer__base">
    <div>&copy; {{ year }} ACC Associates Pty Ltd. All rights reserved.</div>
    <div class="footer__palette" aria-label="Palette swatches">
      <span class="sw" style="background:#1B4332" title="Field #1B4332"></span>
      <span class="sw" style="background:#B4873A" title="Brass #B4873A"></span>
      <span class="sw" style="background:#5C8060" title="Moss #5C8060"></span>
      <span class="sw" style="background:#8A9A87" title="Sage #8A9A87"></span>
      <span class="sw" style="background:#F5F2E8" title="Chalk #F5F2E8"></span>
      <span class="footer__palette-label">Gold &amp; Green</span>
    </div>
  </div>
</footer>
