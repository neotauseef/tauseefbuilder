{% extends "layout.njk" %}
{% block content %}

<section class="page-hero">
  <div class="page-hero__eyebrow">{{ about.intro.eyebrow }}</div>
  <h1 class="page-hero__h">{{ about.intro.headline }}</h1>
</section>

<section class="about-why">
  <div class="about-why__mark">§ HOW WE WORK</div>
  <h2 class="about-why__h">{{ about.why.heading }}</h2>
  <div class="about-why__body">
    {% for p in about.why.body %}<p>{{ p }}</p>{% endfor %}
  </div>
</section>

<section class="people">
  <div class="section__mark">§ PRINCIPAL</div>
  <div class="people__grid people__grid--single">
    {% for p in about.people %}
      <article class="person person--full">
        <div class="person__initials" aria-hidden="true">{{ p.initials }}</div>
        <div class="person__name">{{ p.name }}</div>
        <div class="person__role">{{ p.role }}</div>
        <p class="person__bio">{{ p.bio }}</p>
        {% if p.contacts %}
          <ul class="person__contacts">
            {% for c in p.contacts %}
              <li>
                <span class="person__contact-label">{{ c.label }}</span>
                <a href="{{ c.href }}">{{ c.value }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>

<section class="about-gov">
  <div class="about-why__mark">§ CREDENTIALS</div>
  <h2 class="about-why__h">{{ about.credentials.heading }}</h2>
  <dl class="creds">
    {% for c in about.credentials.items %}
      <div class="creds__row">
        <dt>{{ c.label }}</dt>
        <dd>{{ c.value }}</dd>
      </div>
    {% endfor %}
  </dl>
</section>

<section class="section section--cta-final">
  <h2 class="cta-final__h">Ready to talk to us?</h2>
  <a class="btn btn--primary btn--large" href="/contact">Start an enquiry <span aria-hidden="true">→</span></a>
</section>

{% endblock %}
