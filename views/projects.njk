{% extends "layout.njk" %}
{% block content %}

<section class="page-hero">
  <div class="page-hero__eyebrow">{{ projects.intro.eyebrow }}</div>
  <h1 class="page-hero__h">{{ projects.intro.headline }}</h1>
  <p class="page-hero__lede">{{ projects.intro.lede }}</p>
</section>

<section class="cases">
  {% for c in projects.items %}
    <article class="case">
      <header class="case__head">
        <div class="case__code">{{ c.code }}</div>
        <h2 class="case__sector">{{ c.sector }}</h2>
        <div class="case__loc">{{ c.location }}</div>
        <div class="case__eng">{{ c.engagement }}</div>
      </header>

      <div class="case__body">
        <div class="case__block">
          <h3>Typical brief</h3>
          <p>{{ c.problem }}</p>
        </div>
        <div class="case__block">
          <h3>What we do</h3>
          <p>{{ c.intervention }}</p>
        </div>
      </div>

      <div class="case__outcome case__outcome--label">
        <div class="case__outcome-h">Engagement shape</div>
        <p class="case__outcome-text">{{ c.outcome_label }}</p>
      </div>
    </article>
  {% endfor %}
</section>

<section class="section section--cta-final">
  <h2 class="cta-final__h">A live project that fits one of these types?</h2>
  <a class="btn btn--primary btn--large" href="/contact">Start an enquiry <span aria-hidden="true">→</span></a>
</section>

{% endblock %}
